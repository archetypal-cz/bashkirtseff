# GoTrue Auth Configuration
# Copy this file to .env and set real values.

# PostgreSQL password for the gotrue database user
POSTGRES_PASSWORD=change-me-to-something-random

# Password for the PostgREST authenticator role (low-privilege, separate from gotrue)
POSTGREST_PASSWORD=change-me-to-something-random

# JWT secret — shared between GoTrue and PostgREST
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-something-random

# Google OAuth (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret

# ─── admin-api (admin dashboard backend) ─────────────────────────────
# Password for the read-only admin_api DB role. On a fresh DB volume this
# must be provided to Postgres as the GUC `app.admin_api_password` (same
# mechanism as app.postgrest_password); on an existing DB, create the role
# manually with this literal value (see ../admin-api/README.md).
ADMIN_API_DB_PASSWORD=change-me-to-something-random

# Comma-separated allowlist of admin Google account emails.
ADMIN_EMAILS=you@example.com

# Umami analytics (read-only). Provide EITHER an API key OR username/password.
UMAMI_URL=https://your-umami-instance.example
UMAMI_WEBSITE_ID=
UMAMI_API_KEY=
UMAMI_USERNAME=
UMAMI_PASSWORD=
