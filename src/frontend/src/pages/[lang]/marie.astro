---
import ReadingLayout from '../../layouts/ReadingLayout.astro';
import { createT, localeToContentPath, type SupportedLocale } from '../../i18n/astro';
import { findDiaryLang } from '../../lib/diary-lang-config';
import { withTrailingSlash } from '../../lib/url';
import { quote } from '../../lib/typography';

export function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'en' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'uk' } },
    { params: { lang: 'es' } },
  ];
}

const { lang } = Astro.params;
const t = createT(lang as SupportedLocale);

// Link back to this locale's diary. PILOT es: nothing to uncomment here —
// `findDiaryLang` is the flag. A language whose DIARY_LANGUAGES entry is still
// commented out has no /{lang}/… routes, so the link points at the French source
// rather than at another translation, and switches to /es/ on its own once the
// es block in diary-lang-config.ts is uncommented.
const langContentPath = localeToContentPath(lang as SupportedLocale);
const contentPath = findDiaryLang(langContentPath) ? langContentPath : 'original';
---

<ReadingLayout
  lang={lang}
  title={t('marie.pageTitle')}
  description="Marie Bashkirtseff (1858-1884) was a Ukrainian-born French artist and diarist. Learn about her remarkable life, art, and the famous diary that influenced generations of writers."
  image="/images/og/og-image-composite.jpg"
>
  <article class="max-w-3xl mx-auto">
    <header class="mb-8 pb-6 border-b border-ink/10">
      <h1 class="text-3xl md:text-4xl font-normal text-ink mb-4" style="font-family: var(--font-serif);">
        Marie Bashkirtseff
      </h1>
      <p class="text-muted">1858–1884</p>
    </header>

    <div class="prose-diary space-y-6 text-ink-light">

      <!-- Portrait -->
      <figure class="float-right ml-6 mb-4 w-48 md:w-64">
        <picture>
          <source type="image/avif" srcset="/images/marie/self-portrait-256w.avif 256w, /images/marie/self-portrait-466w.avif 466w" sizes="(min-width: 768px) 256px, 192px" />
          <source type="image/webp" srcset="/images/marie/self-portrait-256w.webp 256w, /images/marie/self-portrait-466w.webp 466w" sizes="(min-width: 768px) 256px, 192px" />
          <img
            src="/images/marie/self-portrait-466w.jpg"
            srcset="/images/marie/self-portrait-256w.jpg 256w, /images/marie/self-portrait-466w.jpg 466w"
            sizes="(min-width: 768px) 256px, 192px"
            width="466"
            height="600"
            alt={t('marie.selfPortraitAlt')}
            class="rounded-lg shadow-md"
            loading="lazy"
            decoding="async"
          />
        </picture>
        <figcaption class="text-xs text-muted mt-2 text-center">
          {t('marie.selfPortraitCaption')}
        </figcaption>
      </figure>

      <h2 class="text-xl font-medium text-ink mt-8 mb-4">{t('marie.life')}</h2>

      <p class="leading-relaxed" set:html={t('marie.lifeText1')} />

      <p class="leading-relaxed">
        {t('marie.lifeText2')}
      </p>

      <p class="leading-relaxed">
        {t('marie.lifeText3')}
      </p>

      <div class="clear-both"></div>

      <h2 class="text-xl font-medium text-ink mt-8 mb-4">{t('marie.artist')}</h2>

      <p class="leading-relaxed">
        {t('marie.artistText1')}
      </p>

      <p class="leading-relaxed">
        {t('marie.artistText2')}
      </p>

      <!-- Gallery -->
      <div class="grid grid-cols-2 gap-4 my-8">
        <figure>
          <a href="https://www.musee-orsay.fr/en/artworks/un-meeting-54" target="_blank" rel="noopener">
            <picture>
              <source type="image/avif" srcset="/images/marie/the-meeting-480w.avif 480w, /images/marie/the-meeting-960w.avif 960w" sizes="(min-width: 800px) 376px, calc(50vw - 24px)" />
              <source type="image/webp" srcset="/images/marie/the-meeting-480w.webp 480w, /images/marie/the-meeting-960w.webp 960w" sizes="(min-width: 800px) 376px, calc(50vw - 24px)" />
              <img
                src="/images/marie/the-meeting-960w.jpg"
                srcset="/images/marie/the-meeting-480w.jpg 480w, /images/marie/the-meeting-960w.jpg 960w"
                sizes="(min-width: 800px) 376px, calc(50vw - 24px)"
                width="960"
                height="1101"
                alt={t('marie.meetingAlt')}
                class="rounded shadow-sm hover:shadow-md transition-shadow"
                loading="lazy"
                decoding="async"
              />
            </picture>
          </a>
          <figcaption class="text-xs text-muted mt-2">{t('marie.meetingCaption')}</figcaption>
        </figure>
        <figure>
          <a href="https://artvee.com/dl/in-the-studio-3/" target="_blank" rel="noopener">
            <picture>
              <source type="image/avif" srcset="/images/marie/in-the-studio-480w.avif 480w, /images/marie/in-the-studio-960w.avif 960w" sizes="(min-width: 800px) 376px, calc(50vw - 24px)" />
              <source type="image/webp" srcset="/images/marie/in-the-studio-480w.webp 480w, /images/marie/in-the-studio-960w.webp 960w" sizes="(min-width: 800px) 376px, calc(50vw - 24px)" />
              <img
                src="/images/marie/in-the-studio-960w.jpg"
                srcset="/images/marie/in-the-studio-480w.jpg 480w, /images/marie/in-the-studio-960w.jpg 960w"
                sizes="(min-width: 800px) 376px, calc(50vw - 24px)"
                width="960"
                height="787"
                alt={t('marie.studioAlt')}
                class="rounded shadow-sm hover:shadow-md transition-shadow"
                loading="lazy"
                decoding="async"
              />
            </picture>
          </a>
          <figcaption class="text-xs text-muted mt-2">{t('marie.studioCaption')}</figcaption>
        </figure>
      </div>

      <h2 class="text-xl font-medium text-ink mt-8 mb-4">{t('marie.diary')}</h2>

      <p class="leading-relaxed">
        {t('marie.diaryText1')}
      </p>

      <p class="leading-relaxed">
        {t('marie.diaryText2')}
      </p>

      <blockquote class="border-l-4 border-accent pl-6 py-2 my-8 italic text-ink">
        {quote(t('quotes.existence'), lang!)}
        {t('quotes.existenceOriginal') && (
          <span class="block text-xs text-muted mt-1 not-italic">
            {t('quotes.existenceOriginal')}
          </span>
        )}
        <footer class="mt-2 text-muted not-italic text-sm">
          — Marie Bashkirtseff, 1884
        </footer>
      </blockquote>

      <h2 class="text-xl font-medium text-ink mt-8 mb-4">{t('marie.feminism')}</h2>

      <p class="leading-relaxed">
        {t('marie.feminismText1')}
      </p>

      <blockquote class="border-l-4 border-ink/20 pl-6 py-2 my-6 italic text-ink-light">
        {t('marie.feminismQuote')}
      </blockquote>

      <h2 class="text-xl font-medium text-ink mt-8 mb-4">{t('marie.legacy')}</h2>

      <p class="leading-relaxed">
        {t('marie.legacyText1')}
      </p>

      <p class="leading-relaxed">
        {t('marie.legacyText2')}
      </p>

      <h2 class="text-xl font-medium text-ink mt-8 mb-4">{t('marie.links')}</h2>

      <ul class="space-y-2 text-sm">
        <li>
          <a href="https://en.wikipedia.org/wiki/Marie_Bashkirtseff" class="text-accent hover:text-accent-light" target="_blank" rel="noopener">
            Wikipedia
          </a>
        </li>
        <li>
          <a href="https://www.wikiart.org/en/marie-bashkirtseff" class="text-accent hover:text-accent-light" target="_blank" rel="noopener">
            WikiArt — {t('marie.allPaintings')}
          </a>
        </li>
        <li>
          <a href="https://www.musee-orsay.fr/en/node/288025" class="text-accent hover:text-accent-light" target="_blank" rel="noopener">
            Musée d'Orsay
          </a>
        </li>
        <li>
          <a href="https://commons.wikimedia.org/wiki/Category:Marie_Bashkirtseff" class="text-accent hover:text-accent-light" target="_blank" rel="noopener">
            Wikimedia Commons — {t('marie.imagesAndPhotos')}
          </a>
        </li>
        <li>
          <a href="https://gallica.bnf.fr/ark:/12148/bpt6k65726142" class="text-accent hover:text-accent-light" target="_blank" rel="noopener">
            Gallica (BnF) — {t('marie.originalManuscripts')}
          </a>
        </li>
        <li>
          <a href="https://daily.jstor.org/marie-bashkirtseffs-diary/" class="text-accent hover:text-accent-light" target="_blank" rel="noopener">
            JSTOR Daily — {t('marie.articleAboutDiary')}
          </a>
        </li>
      </ul>

    </div>

    <nav class="mt-12 pt-8 border-t border-ink/10 flex justify-between" aria-label={t('a11y.pageNav')}>
      <a href={withTrailingSlash(`/${lang}/about`)} class="text-muted hover:text-ink transition-colors">
        ← {t('marie.aboutProject')}
      </a>
      <a href={withTrailingSlash(`/${contentPath}`)} class="text-muted hover:text-ink transition-colors">
        {t('marie.readDiary')} →
      </a>
    </nav>
  </article>
</ReadingLayout>

<script>
  // Save language preference when user visits this page
  const pathParts = window.location.pathname.split('/').filter(Boolean);
  const lang = pathParts[0];
  if (lang && ['cs', 'en', 'fr', 'uk', 'es'].includes(lang)) {
    localStorage.setItem('ui-language', lang);
  }
</script>
