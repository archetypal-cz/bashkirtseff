---
// Redirect to localized version based on user's language preference
---
<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex">
  <title>Privacy - Marie Bashkirtseff</title>
  <script>
    (function() {
      var saved;
      try { saved = localStorage.getItem('ui-language'); } catch(e) {}
      if (saved && ['cs', 'fr', 'en', 'uk', 'es'].indexOf(saved) !== -1) {
        window.location.replace('/' + saved + '/privacy');
        return;
      }
      var browserLangs = navigator.languages || [navigator.language || navigator.userLanguage];
      var supported = ['cs', 'en', 'fr', 'uk', 'es'];
      var targetLang = 'en';
      for (var i = 0; i < browserLangs.length; i++) {
        var lang = browserLangs[i].toLowerCase().split('-')[0];
        var normalized = lang === 'cz' ? 'cs' : lang;
        if (supported.indexOf(normalized) !== -1) {
          targetLang = normalized;
          break;
        }
      }
      window.location.replace('/' + targetLang + '/privacy');
    })();
  </script>
  <noscript>
    <meta http-equiv="refresh" content="0; url=/en/privacy">
  </noscript>
</head>
<body>
  <p>Redirecting...</p>
</body>
</html>
