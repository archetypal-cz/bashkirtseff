# Frontend build-time environment variables
# Copy to .env on the deploy server (not committed to git).

# Umami analytics — get the website ID from the Umami dashboard
# after adding bashkirtseff.org as a website.
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_UMAMI_URL=https://analytics.bashkirtseff.org

# Auth — GoTrue (self-hosted)
PUBLIC_AUTH_URL=https://auth.bashkirtseff.org

# API — PostgREST or custom API for reports
PUBLIC_API_URL=https://api.bashkirtseff.org
