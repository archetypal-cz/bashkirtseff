# Frontend build-time environment variables
# Copy to .env on the deploy server (not committed to git).

# Umami analytics. In CI these are injected from GitHub Actions variables
# (vars.PUBLIC_UMAMI_URL / vars.PUBLIC_UMAMI_WEBSITE_ID) by deploy.yml.
# For local builds, set them here (the website ID is public, not secret).
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_UMAMI_URL=

# Auth — GoTrue (self-hosted)
PUBLIC_AUTH_URL=https://auth.bashkirtseff.org

# API — PostgREST or custom API for reports
PUBLIC_API_URL=https://api.bashkirtseff.org

# Admin dashboard API (admin-api service)
PUBLIC_ADMIN_API_URL=https://admin.bashkirtseff.org
