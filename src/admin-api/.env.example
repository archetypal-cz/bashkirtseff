# Admin API configuration
# Copy to .env for local dev. In production these are set in
# ../auth/docker-compose.yml (see ../auth/.env).

PORT=8080

# JWT secret — MUST match GoTrue + PostgREST (src/auth/.env JWT_SECRET).
JWT_SECRET=change-me-to-match-auth

# Comma-separated admin email allowlist.
ADMIN_EMAILS=you@example.com

# Read-only DB connection (the admin_api role created in src/auth/init.sql).
DATABASE_URL=postgresql://admin_api:change-me@localhost:5432/gotrue

# Browser origins allowed via CORS.
CORS_ORIGINS=https://bashkirtseff.org,http://localhost:4321

# Umami analytics (URL + website ID; the website ID is public, not secret).
UMAMI_URL=https://your-umami-instance.example
UMAMI_WEBSITE_ID=
# Provide EITHER an API key …
UMAMI_API_KEY=
# … OR a (read-only) username/password to log in with.
UMAMI_USERNAME=
UMAMI_PASSWORD=
