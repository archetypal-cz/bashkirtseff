     "old": "103.0007",
     "set_french": "Il avait l'air d'un petit astèque\nEt son frère était architèque\nTous deux aimaient la nommée Baskirtseff\nà Montmartre."
    },
    {
     "old": "103.0008",
     "set_french": "Il avait peint deux amoureux\nEt ça n'était rien de fameux\nLa toile étant partout très verte\nà Montmartre."
    },
    {
     "old": "103.0009",
     "set_french": "D'puis qu'il l'avait payé en fleurs\nL'marchand lui r'fusait des couleurs\nIl en aurait commis des meurtres\nà Montmartre."
    },
    {
     "old": "103.0010",
     "set_french": "Mais quand il eu vu mes tableaux\nIl les trouva si beaux, si beaux\nQu'il en resta la bouche ouverte\nà Montmartre."
    },
    {
     "old": "103.0011",
     "set_french": "Se voyant si vite enfoncé\nIl se trouva embarassé\nEt alla pleurer sous un tertre\nà Montmartre."
    },
    {
     "new": {
      "french": "Alors et ce fut là l'bouquet\nIl se soûlât chez l'mastroquet\nS'faisant payer des absinthes vertes\nà Montmartre.",
      "rsr": "Split (paragraph wave 2): print paragraph 9 of 12 of the re-cut run 103.0004…103.0011 (Mon Journal t.16; split point verified on the scan indentation / print layout)."
     }
    },
    {
     "new": {
      "french": "Enfin lâché par Albert Wolff\nIl se cacha sous l'nom d'Adolphe\nToute la journée n'faisant que geindre\nrue Legeindre.",
      "rsr": "Split (paragraph wave 2): print paragraph 10 of 12 of the re-cut run 103.0004…103.0011 (Mon Journal t.16; split point verified on the scan indentation / print layout)."
     }
    },
    {
     "new": {
      "french": "Lorsqu'il mourut comme un vieux rat\nIl n'y eut qu'son frère qui le pleura\nCar Emile est une âme tendre\nrue Lengendre.",
      "rsr": "Split (paragraph wave 2): print paragraph 11 of 12 of the re-cut run 103.0004…103.0011 (Mon Journal t.16; split point verified on the scan indentation / print layout)."
     }
    },
