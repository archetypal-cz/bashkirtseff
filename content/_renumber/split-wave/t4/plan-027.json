    {
     "old": "027.0117",
     "set_french": "Quel jour de vexations et d'humiliations profondes !"
    },
    {
     "new": {
      "french": "Les exclamations et les plaintes rendent la douleur triviale. Je ne me plaindrai point, je raconterai seulement ce qui m'arrive aujourd'hui.",
      "rsr": "Split (paragraph wave): print paragraph 2 of 2 of 027.0117, which held 2 printed paragraphs under one ID (Mon Journal t.4; tome04.docx; split points checked by the survey on the docx and the scan indentation)."
     }
    },
    {
     "old": "027.0118"
