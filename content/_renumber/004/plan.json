   "file": "1873-04-21.md",
   "date": "1873-04-21",
   "heading": "Lundi 21 avril 1873",
   "paragraphs": [
    {
     "old": "004.0123"
    },
    {
     "old": "004.0124"
    },
    {
     "old": "004.0125"
    },
